# Node.js API
PORT=3001
HOST=0.0.0.0

# Absolute or project-relative SQLite file
DATABASE_PATH=server/data/campus-smart-dispatch-platform.sqlite

# AES-256-GCM master secret for the DeepSeek API key stored in SQLite.
# Keep this file outside Git and back it up with the database.
SECRETS_PATH=server/data/.secrets-key

# Optional comma-separated origins for direct cross-origin API access.
# Vite development proxy and the production same-origin server do not need this.
CORS_ORIGINS=

# 生产环境默认不信任任意 localhost Origin；本机联调确需跨端口时设为 1。
ALLOW_LOCAL_CORS=0

# 可选：设置后，新账号注册必须同时提交该邀请码。
REGISTRATION_CODE=

# 前端与独立 API 域名部署时使用；同源部署留空。
VITE_API_BASE_URL=
